# No trailing slash. `node_modules/` matches a DIRECTORY only, so a symlink
# named node_modules is not ignored — which is how an absolute link to another
# machine's install got committed and clobbered every checkout's real one.
node_modules
.next/
dist/
# Secrets. `.env.*` deliberately covers the whole family: the old list matched
# .env, .env.local and .env.*.local only, so a .env.production or .env.backup
# would have been committable. The repo is public and .env holds the OpenRouter
# key.
.env
.env.*
!.env.example
*.tsbuildinfo
data/.estimate.json
next-env.d.ts
.DS_Store
.vercel
